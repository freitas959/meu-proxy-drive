# Obrigatória para o roteiro e para a capa em ilustração.
# Sem ela o app carrega e navega, mas a geração responde 503.
ANTHROPIC_API_KEY=

# Necessária só para a capa em "Foto realista" (Gemini / nano banana).
# Sem ela o app funciona normalmente na opção "Ilustração".
# O modelo padrão (gemini-2.5-flash-image) tem cota no nível gratuito; os
# Flash mais novos e o Pro exigem faturamento ativo no Google.
GEMINI_API_KEY=

# ---------------------------------------------------------------- Supabase ---
# As duas primeiras podem ir para o navegador (é para isso que existem).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Esta NÃO. A service role ignora todo o RLS: só nas rotas de servidor, nunca
# num arquivo que o navegador baixa, nunca no git, nunca colada num chat.
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais: sobrescrevem os modelos padrão.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL_RAPIDO=claude-haiku-4-5-20251001
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
